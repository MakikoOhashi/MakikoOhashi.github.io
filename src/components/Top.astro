---
import ttiImg from '../assets/Inbound.png';
import pocketShiroiroImg from '../assets/PocketShiroiro-ios.png';
import wakarumadeImg from '../assets/Wakarumade-ios.png';
import daisukiImg from '../assets/DAISUKI.png';
import discountImg from '../assets/DISCOUNT.png';
import honoluluImg from '../assets/HONOLULU.png';
import headerPattern from '../assets/back.png';

const currentYear = new Date().getFullYear();
---

<!-- Removed all exports and const - using pure HTML+CSS instead -->
<main class="min-h-screen bg-white text-gray-900">
  <!-- Hero Section -->
  <section class="relative overflow-hidden px-4 py-16 md:px-8 md:py-24 border-b border-gray-100">
    <div class="absolute right-[-60px] top-1/2 hidden -translate-y-1/2 md:block">
      <img
        src={headerPattern.src}
        alt=""
        aria-hidden="true"
        class="w-[360px] max-w-none opacity-25 lg:w-[460px]"
      />
    </div>
    <div class="relative z-10 max-w-6xl mx-auto">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">Makiko Ohashi</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-gray-700 md:text-xl">
        Full-stack Web Developer
      </p>
      <p class="mt-2 max-w-3xl text-base leading-relaxed text-gray-600 md:text-lg">
        TypeScript / React / Next.js / Node.js
      </p>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-gray-700 md:text-lg">
        Formerly worked in international trade operations, where I saw firsthand how operational workflows and legacy systems affect day-to-day business.
      </p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-700 md:text-lg">
        I now build and maintain production web applications for clients, while developing my own products around problems I have encountered in real-world operations.
      </p>
    </div>
  </section>

  <!-- Professional Experience Section -->
  <section class="py-16 px-4 md:py-24 md:px-8 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900">Professional Experience</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-700">
        Production web application development, maintenance, and third-party integrations for SaaS and business systems.
      </p>
      <ul class="mt-8 space-y-4 text-base leading-relaxed text-gray-700 md:text-lg">
        <li><strong>SaaS &amp; Business Systems</strong> — Ongoing feature development, maintenance, authentication, database operations, and production improvements for React / TypeScript applications.</li>
        <li><strong>Payment Integrations</strong> — Implementation and maintenance of payment flows using Stripe and PayPal, including webhooks and production operations.</li>
        <li><strong>Third-party Integrations</strong> — Integration of external services including Zoom Meeting SDK, LINE, Shopify, and AI APIs.</li>
        <li><strong>Backend &amp; Infrastructure</strong> — API and data-layer development using Node.js, Fastify, PostgreSQL, Supabase, Cloudflare Workers, and D1.</li>
        <li><strong>Shopify Development</strong> — Store builds, theme customization, application development, and operational improvements for merchants.</li>
      </ul>
    </div>
  </section>

  <!-- Products Section -->
  <section class="pt-16 px-4 md:pt-24 md:px-8">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900">Products</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-700">
        Shopify App / iOS apps / LINE learning service
      </p>
    </div>
  </section>

  <!-- Inbound Tracking Section -->
  <section class="py-16 px-4 md:py-24 md:px-8">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
      <div class="flex-1">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 text-center md:text-left">Inbound Tracking</h2>
        <p class="text-lg mb-4"><strong>Origin:</strong>Small import merchants struggle to track in-transit inventory; existing ERP tools are too heavy for their scale.</p>
        <p class="text-lg mb-4"><strong>Purpose:</strong>Built a Shopify app to automatically track shipments using trade documents and sync inventory on warehouse arrival.</p>
        <p>Shopify app for merchants importing goods. </p>
        <p>Tracks in-transit inventory using trade documents, </p>
        <p>syncs to Shopify on warehouse arrival. </p>
        <p class="text-lg mb-4">Live on <a href="https://apps.shopify.com/tracktoinventory?locale=en" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">App Store</span></a>. Featured on <a href="https://tsun.ec/en/blogs/articles/about-track-to-inventory" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">TSUN.ec</span></a>.</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Remix</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Node.js</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Supabase</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">TypeScript</span>
        </div>
        <div class="flex gap-4">
          <a href="https://github.com/MakikoOhashi/track-to-inventory" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
          <a href="https://apps.shopify.com/tracktoinventory?locale=en" class="text-blue-600 hover:underline" target="_blank">Launch App</a>
        </div>
      </div>
      <div class="flex-1">
        <a href="https://apps.shopify.com/tracktoinventory?locale=en" class="block" target="_blank">
          <img src={ttiImg.src} alt="Inbound Tracking" class="w-full h-auto rounded-lg shadow-md hover:shadow-lg transition-shadow" />
        </a>
      </div>
    </div>
  </section>

  <!-- Pocket Shiroiro Section -->
  <section class="py-16 px-4 md:py-24 md:px-8">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
      <div class="flex-1">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 text-center md:text-left">
          <span class="block">Pocket Shiroiro</span>
          <span class="block text-2xl md:text-2xl">- iOS Bookkeeping App</span>
        </h2>
        <p class="mb-4">A lightweight bookkeeping app for Japanese sole proprietors.</p>
        <p class="mb-4">Built to make white-tax-return bookkeeping simple: users can record income and expenses, categorize transactions, and save their data directly to their own Notion database.</p>
        <p class="mb-4">The app focuses on practical solo-business workflows rather than full accounting software complexity.</p>
        <p class="mb-4">Available on the <a href="https://apps.apple.com/jp/app/pocket-shiroiro/id6777675053" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">App Store</span></a>. Includes a <a href="https://www.notion.com/ja/templates/pocket-shiroiro?clientBuildTarget=client" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">Notion template</span></a> for saving bookkeeping data.</p>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">SwiftUI</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Notion API</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Cloudflare Workers</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">StoreKit</span>
        </div>
        <div class="flex gap-4">
          <a href="https://apps.apple.com/jp/app/pocket-shiroiro/id6777675053" class="text-blue-600 hover:underline" target="_blank">App Store</a>
          <a href="https://www.notion.com/ja/templates/pocket-shiroiro?clientBuildTarget=client" class="text-blue-600 hover:underline" target="_blank">Notion Template</a>
        </div>
      </div>
      <div class="flex-1">
        <img src={pocketShiroiroImg.src} alt="Pocket Shiroiro" class="w-full h-auto rounded-lg" />
      </div>
    </div>
  </section>

  <!-- WAKARUMADE Section -->
  <section class="py-16 px-4 md:py-24 md:px-8">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
      <div class="flex-1">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 text-center md:text-left">
          <span class="block">WAKARUMADE</span>
          <span class="block text-2xl md:text-2xl">- iOS Math Learning App</span>
        </h2>
        <p class="mb-4">A comprehension-first math learning app now available on iOS.</p>
        <p class="mb-4">Built to help children understand step-by-step reasoning, not just memorize answers.</p>
        <p class="mb-4">The native iOS version uses on-device OCR and a teacher-style chat flow to turn printed math problems into guided learning conversations.</p>
        <p class="mb-4">Started as a solo project for <a href="https://devfolio.co/projects/wakarumade-f890" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">Hack This Fall</span></a> and evolved through rapid iteration with real user feedback. The app adjusts difficulty in real time based on student performance.</p>
        <p class="mb-4">Available on the <a href="https://apps.apple.com/jp/app/%E3%82%8F%E3%81%8B%E3%82%8B%E3%81%BE%E3%81%A7/id6760085401" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">App Store</span></a> and on the <a href="https://wakarumade-app.vercel.app/" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">landing page</span></a>. Built for <a href="https://devfolio.co/projects/wakarumade-f890" class="text-blue-600 hover:underline" target="_blank"><span class="font-semibold cursor-pointer">Hack This Fall</span></a>.</p>
        <p class="mb-4">🏆 Selected for Hacker House and Demo Day as one of the top finalist projects from the month-long hackathon.</p>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">SwiftUI</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Supabase</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Gemini</span>
        </div>
        <div class="flex gap-4">
          <a href="https://apps.apple.com/jp/app/%E3%82%8F%E3%81%8B%E3%82%8B%E3%81%BE%E3%81%A7/id6760085401" class="text-blue-600 hover:underline" target="_blank">App Store</a>
          <a href="https://wakarumade-app.vercel.app/" class="text-blue-600 hover:underline" target="_blank">Landing Page</a>
          <a href="https://github.com/MakikoOhashi/wakarumade" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
        </div>
      </div>
      <div class="flex-1">
        <a href="https://wakarumade-app.vercel.app/" class="block" target="_blank">
          <img src={wakarumadeImg.src} alt="WAKARUMADE" class="w-full h-auto rounded-lg" />
        </a>
      </div>
    </div>
  </section>

  <!-- Other Projects Section -->
  <section class="py-16 px-4 md:py-24 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <div class="flex flex-col gap-4 p-4 border-t border-gray-200 pt-6">
          <h3 class="text-xl font-bold text-gray-900">More Projects</h3>
          <p>Additional apps and small tools I've built across web, iOS, Shopify, and business workflows.</p>
          <div class="flex gap-4 flex-wrap">
            <a href="https://kima-7jx.pages.dev/" class="text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">View all projects on KIMA →</a>
          </div>
        </div>
      </div>

      <div class="mb-8">
        <button class="toggle-btn flex items-center gap-2 text-xl font-bold text-gray-900 hover:text-blue-600 transition-colors" data-target="experiments">
          <span class="toggle-arrow">▸</span>
          <span>Experiments</span>
        </button>

        <div id="experiments" class="toggle-content hidden mt-6">
          <!-- Backend Experiments -->
          <div class="space-y-6">
          <div class="flex flex-col gap-4 p-4 border-t border-gray-200 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Deterministic Forecasting Backend (Hackathon Project)</h3>
            <p class="mb-2">Backend-only forecasting prototype that separates deterministic demand calculations from AI-generated explanations.</p>
            <p class="mb-2 italic text-sm">This section focuses on backend design experiments — a concise log of architecture and reproducibility checks.</p>
            <div class="flex gap-4">
              <a href="https://github.com/MakikoOhashi/Forecast-Ready" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://youtu.be/wwGYLxHi4lw" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="/docs/Motia_Certificates.pdf" class="text-blue-600 hover:underline" target="_blank">Certificates</a>
            </div>
          </div>
        </div>

          <!-- Workflow & Automation Experiments -->
          <div class="space-y-6">
          <div class="flex flex-col gap-4 p-4 border-t border-gray-200 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Ruidaichan – AI-to-PDF Math Worksheet Generator (iOS + Server)</h3>
            <p class="mb-2">iOS-native app that generates printable A4 math worksheets from photographed problems.</p>
            <p class="mb-2"><strong>Key features:</strong></p>
            <ul class="list-disc list-inside mb-2 space-y-1">
              <li>Free-tier quota enforcement with Redis (monthly caps, atomic Lua)</li>
              <li>Privacy-first design (no image retention, minimal identifiers)</li>
              <li>Designed to pass App Store review with minimal UX friction</li>
            </ul>
            <p class="mb-2"><strong>Status:</strong> Available on the App Store</p>
            <div class="flex gap-4 flex-wrap">
              <a href="https://apps.apple.com/jp/app/id6759811359" class="text-blue-600 hover:underline" target="_blank">App Store</a>
              <a href="https://github.com/MakikoOhashi/ruidaichan" class="text-blue-600 hover:underline" target="_blank">GitHub (iOS App)</a>
              <a href="https://github.com/MakikoOhashi/ruidaichan-api" class="text-blue-600 hover:underline" target="_blank">GitHub (Server)</a>
            </div>
          </div>

          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">MentorHQ – AI Learning OS (Hackathon Project)</h3>
            <p class="mb-2">AI-powered learning workspace that builds a learner model from observations made during study sessions, rather than simply evaluating correct and incorrect answers.</p>
            <p class="mb-2"><strong>Key features:</strong></p>
            <ul class="list-disc list-inside mb-2 space-y-1">
              <li>Observation-first learner modeling</li>
              <li>AI Coach Team (Reading / Memory / Pattern / Review)</li>
              <li>Daily Review and Tomorrow Plan generation</li>
              <li>Optional learner chat that also becomes part of the learner model</li>
            </ul>
            <p class="mb-2">Built with Next.js, React, TypeScript, Firestore, and Gemini.</p>
            <p class="mb-2"><strong>Status:</strong> Built for Findy AI Hackathon 2026.</p>
            <div class="flex gap-4 flex-wrap">
              <a href="https://mentorhq-528335584921.asia-northeast2.run.app/" class="text-blue-600 hover:underline" target="_blank">Live Demo</a>
              <a href="https://github.com/MakikoOhashi/mentorHQ" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://youtu.be/eRULBU8svRM" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="https://protopedia.net/prototype/8775" class="text-blue-600 hover:underline" target="_blank">Proto Pedia</a>
            </div>
          </div>

          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Coaching Company Ops (Hackathon Project)</h3>
            <p class="mb-2">AI coaching product for the Japanese Management Operations Supervisor Exam, paired with a company-side operations layer that reviews learner progress and decides when to adjust plans or escalate.</p>
            <p class="mb-2">Built as a lightweight product on Cloudflare Pages and Workers, with Supabase for question/session data and Airia for company-side decision workflows.</p>
            <p class="mb-4">Explored how to separate learner-facing coaching from operational intelligence while making AI-run company decisions visible in the UI.</p>
            <div class="flex flex-wrap gap-4">
              <a href="https://coaching-company.pages.dev/" class="text-blue-600 hover:underline" target="_blank">Live Demo</a>
              <a href="https://github.com/MakikoOhashi/coaching-company" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://www.youtube.com/watch?v=ryLPaiVdb6Y" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="https://devpost.com/software/coaching-company-ops" class="text-blue-600 hover:underline" target="_blank">DevPost</a>
              <a href="https://community.airia.ai/import-agent/CUmyXGjL4IrFhDEcjQznpq2epY8nbHSU3qyYLepa2SY" class="text-blue-600 hover:underline" target="_blank">Airia Agent</a>
            </div>
          </div>

          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Trade Shelf Agent (Hackathon Project)</h3>
            <p class="mb-2">AI operational assistant for trade and logistics workflows, built to organize shipment, invoice, and trade-document states while handling ambiguous operational inquiries from sales teams.</p>
            <p class="mb-2">Designed around relationship resolution across Shipment / Invoice / SI records, with Slack and web inputs feeding a unified workflow layer backed by Azure OpenAI.</p>
            <p class="mb-4">Explored human-in-the-loop approvals, activity trace design, and auditability patterns for operational AI systems. Built for Microsoft Agent Hackathon 2026.</p>
            <div class="flex flex-wrap gap-4">
              <a href="https://github.com/MakikoOhashi/trade-shelf-agent" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://trade-shelf-agent-web-eng2hrd9cnbadsck.japanwest-01.azurewebsites.net/" class="text-blue-600 hover:underline" target="_blank">Live Demo</a>
              <a href="https://www.youtube.com/watch?v=f34dxzyMoKc" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="https://zenn.dev/kimadev/articles/557c4ba398a5e2" class="text-blue-600 hover:underline" target="_blank">Zenn Article</a>
            </div>
          </div>

          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Natural Language Workflow Automation (Hackathon Project)</h3>
            <p class="mb-2">Explored natural-language-driven workflow automation for operational tasks.</p>
            <p class="mb-2">Learned the limits of language interfaces in multi-step business processes.</p>
            <p class="mb-4">Did not continue as a backend-first system.</p>
            <div class="flex gap-4">
              <a href="https://github.com/MakikoOhashi/sales-reservation-agent" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://www.youtube.com/watch?v=sz1uaFGe8ds" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="/docs/AI_Agents.pdf" class="text-blue-600 hover:underline" target="_blank">Certificate</a>
            </div>
          </div>
        </div>

          <!-- Evaluation & Generation Control Experiments -->
          <div class="space-y-6">
          <div class="flex flex-col gap-4 p-4 border-t border-gray-200 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Stable Difficulty Generation Engine (Hackathon Project)</h3>
            <p>Evaluation-first AI generation demo that audits and controls inference questions across difficulty and reasoning dimensions.</p>
            <p><strong>Difficulty axes:</strong> L / S / A / R</p>
            <p><strong>States:</strong> Explicit accept / soft-accept / reject</p>
            <p class="mt-2">Built for DigitalOcean Hackathon</p>
            <div class="flex gap-4 mt-2">
              <a href="https://github.com/MakikoOhashi/deterministic-ai-control-engine" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://deterministic-ai-control-engine-dkcf4.ondigitalocean.app/" class="text-blue-600 hover:underline" target="_blank">Live Demo</a>
              <a href="https://youtu.be/GpsubMHJziE" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="https://devpost.com/software/deterministic-ai-control-engine" class="text-blue-600 hover:underline" target="_blank">DevPost</a>
            </div>
          </div>
          
          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Audit Risk Forecast Tracker (Hackathon Project)</h3>
            <p>Simulates tax audit trigger questions from spreadsheet-based bookkeeping data using Gemini.</p>
            <p><strong>Infra:</strong> Gemini (reasoning) + Google Sheets (source of truth) + Firebase (non-authoritative cache), with demo/prod isolation</p>
            <p>Built for Gemini3 Hackathon</p>
              <div class="flex gap-4 mt-2">
                <a href="https://github.com/MakikoOhashi/Gemini-Expense-Tracker" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
                <a href="https://gemini-expense-tracker.onrender.com/" class="text-blue-600 hover:underline" target="_blank">Live Demo</a>
                <a href="https://youtu.be/c9D62P5rvTc" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
                <a href="https://devpost.com/software/gemini-powered-expense-tracker" class="text-blue-600 hover:underline" target="_blank">DevPost</a>
              </div>
            </div>

          <div class="flex flex-col gap-4 p-4 border-t border-gray-100 pt-6">
            <h3 class="text-xl font-bold text-gray-900">Pencil Stuck Marker (Hackathon Project)</h3>
            <p>Behavior-aware AI intervention system for pen-based learning on iPad.</p>
            <p>Detects hesitation patterns and triggers optional, non-solution nudges without content understanding.</p>
            <p><strong>Signals:</strong> Stall time / Write–erase loops</p>
            <p><strong>States:</strong> Observe / Suggest / Withdraw</p>
            <p><strong>Infra:</strong> Swift + Vision Agents + Python (FastAPI) + Gemini</p>
            <p>Built for WeMakeDevs Vision Hackathon</p>
            <div class="flex gap-4 mt-2">
              <a href="https://github.com/MakikoOhashi/pencil-stuck-marker" class="text-blue-600 hover:underline" target="_blank">GitHub</a>
              <a href="https://www.youtube.com/watch?v=FxaYav5PJaU" class="text-blue-600 hover:underline" target="_blank">Demo Video</a>
              <a href="/docs/VisionAgents.pdf" class="text-blue-600 hover:underline" target="_blank">Certificate</a>
            </div>
          </div>

        </div>
        </div>
      </div>
    </div>
  </section>

<!-- Other Shopify partner Section -->
  <section class="py-16 px-4 md:py-24 md:px-8 bg-gray-50">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
      <div class="flex-1">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 text-center md:text-left">Shopify Development</h2>
        <p class="mb-4">Developed Shopify stores for small businesses, including full store builds, theme customization, and feature improvements.</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Shopify</span>
          <span class="text-sm px-2 py-1 bg-gray-200 text-gray-700 rounded">Liquid</span>
        </div>
        <a href="https://partners.shopify.com/3728861/" class="text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">Shopify Partner Account</a>
      </div>
      <div class="flex-1">
        <div class="grid grid-cols-3 gap-4 h-48">
          <img src={daisukiImg.src} alt="DAISUKI" class="w-full h-full object-cover rounded" />
          <img src={discountImg.src} alt="DISCOUNT" class="w-full h-full object-cover rounded" />
          <img src={honoluluImg.src} alt="HONOLULU" class="w-full h-full object-cover rounded" />
        </div>
      </div>
    </div>
